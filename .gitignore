# ═══════════════════════════════════════════════════
# Shared workspace .gitignore
# ═══════════════════════════════════════════════════

# ── Personal / machine-specific (never shared) ────
/Machine/
/temp/

# Cloned repositories keep their own version control.
# The exclusion uses the same filename as the instructions: AGENTS.md
/Repos/*
!/Repos/AGENTS.md

# Obsidian session state. Notes in brain/ stay tracked.
brain/.obsidian/workspace.json

# ── Personal knowledge bases (optional: remove a line to share yours) ──
# To keep your personal KB private, add it here:
# /Knowledge/YourName-Brain/

# ── OS / editor noise ─────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Node / Python artifacts ───────────────────────
node_modules/
__pycache__/
*.pyc
.env
.env.local
